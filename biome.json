{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 90,
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off",
        "noUselessRename": "error",
        "noUselessConstructor": "off",
        "useOptionalChain": "warn",
        "noForEach": "error",
        "noExtraBooleanCast": "error",
        "useRegexLiterals": "error",
        "useFlatMap": "error",
        "useLiteralKeys": "error",
        "noUselessTernary": "error",
        "noBannedTypes": "error"
      },
      "correctness": {
        "noSwitchDeclarations": "warn",
        "noVoidTypeReturn": "error",
        "noUnsafeFinally": "error",
        "noUnusedVariables": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        "useExplicitType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noEvolvingTypes": "warn",
        "noEmptyInterface": "off",
        "noPrototypeBuiltins": "warn",
        "noConfusingVoidType": "error",
        "noAssignInExpressions": "error",
        "noMisleadingCharacterClass": "error",
        "noEmptyBlockStatements": "error",
        "noConstEnum": "error",
        "noDoubleEquals": "error",
        "noGlobalIsNan": "error",
        "noSkippedTests": "error"
      },
      "style": {
        "noUselessElse": "warn",
        "useNamingConvention": {
          "level": "off",
          "options": {
            "strictCase": false
          }
        },
        "useTemplate": "warn",
        "useDefaultParameterLast": "warn",
        "useEnumInitializers": "warn",
        "useImportType": "off",
        "noInferrableTypes": "error",
        "useNodejsImportProtocol": "warn",
        "useNumberNamespace": "warn",
        "useExportType": "off",
        "useShorthandFunctionType": "off",
        "useForOf": "error",
        "useBlockStatements": "warn"
      },
      "performance": {
        "noDelete": "error",
        "noAccumulatingSpread": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/Domain/**/*.ts", "src/**/Application/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/Infrastructure/**"],
                    "message": "The domain and application layers should not depend on infrastructure implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/core/**/Domain/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/Application/*"],
                    "message": "The domain layer should not depend on the application layer."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage"
    ]
  }
}
