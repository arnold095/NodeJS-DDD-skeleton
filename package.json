{
  "name": "nodejs-ddd-skeleton",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env ./dist/src/Apps/App.js",
    "build": "rm -rf dist && swc src --copy-files -d dist",
    "lint": "biome check --diagnostic-level=error && node CheckTypes.js",
    "lint:biome": "biome check --diagnostic-level=error",
    "lint:types": "node CheckTypes.js",
		"test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "vitest run --project e2e",
		"test:unit:coverage": "vitest run --project unit --coverage",
    "dev": "concurrently 'node --run watch-compile' 'node --run watch-dev'",
    "watch-compile": "rm -rf dist && swc src --copy-files -w --out-dir dist",
    "watch-dev": "wait-on ./dist/src/Apps/App.js && node --env-file=.env --watch ./dist/src/Apps/App.js",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnold095/NodeJS-DDD-skeleton.git"
  },
  "engines": {
    "node": ">24.0.0"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arnold095/NodeJS-DDD-skeleton/issues"
  },
  "homepage": "https://github.com/arnold095/NodeJS-DDD-skeleton#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "diod": "^3.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "5.8.5",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.2.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@faker-js/faker": "10.4.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.33",
    "@types/glob": "9.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "chokidar": "5.0.0",
    "concurrently": "9.2.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "supertest": "7.2.2",
    "testcontainers": "11.14.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.5",
    "vitest-mock-extended": "4.0.0",
    "wait-on": "9.0.5"
  },
  "lint-staged": {
    "*.(j|t)s": "biome check --diagnostic-level=error src test"
  }
}